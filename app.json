{
  "expo": {
    "name": "app-crew-notes-app",
    "slug": "app-crew-notes-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "appcrewnotesapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appcrewnotesapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.appcrewnotesapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "8a8bf8d8-f0bc-4a0e-9c9a-bd5aa5ecf75d"
      }
    }
  }
}
